{
    "name": "timer",
    "version": "1.0.0",
    "description": "",
    "main": "timer.ts",
    "scripts": {
        "prebuild": "prettier --list-different $PWD/src/*.ts && rm -rvf docs",
        "build": "mkdir $PWD/docs && cp $PWD/src/*.html docs/ && cp $PWD/src/*.png docs/ && npx postcss $PWD/src/*.css --use autoprefixer -d $PWD/docs/ && npx tsc",
        "env": "env"
    },
    "keywords": [],
    "author": "Joren Van Onder <joren@jvo.sh>",
    "license": "GPL-3.0-or-later",
    "devDependencies": {
        "autoprefixer": "^9.6.1",
        "postcss-cli": "^6.1.3",
        "prettier": "1.18.2",
        "typescript": "^5.9.3"
    }
}
